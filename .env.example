# I Want A Visa (www.iwantavisa.com) — Cambodia Portal Environment Variables
# Zero hardcoded credentials. Copy to .env.local when connecting live backends.

VITE_APP_NAME="I Want A Visa Cambodia"
VITE_APP_DOMAIN="https://www.iwantavisa.com"
VITE_DEFAULT_COUNTRY="KH"

# Future Database (Firebase / Firestore — to be added later)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Named Firestore database ID, e.g. "iwantavisa" (leave blank for "(default)")
VITE_FIREBASE_DATABASE_ID=""

# Sign-in: leave unset for Google sign-in; "demo" = password-less demo accounts (automated tests).
VITE_AUTH_MODE=""
# Development only — Firebase Auth emulator (firebase emulators:start --only auth). Ignored in builds.
VITE_FIREBASE_AUTH_EMULATOR_URL=""

# imgbb photo uploads (public in the browser bundle — use a dedicated imgbb account/key).
VITE_IMGBB_API_KEY=""

# Payments: Stripe Checkout runs on the server (functions/). The browser needs NO Stripe key.
# ⚠ Stripe secret keys (sk_…) and webhook secrets (whsec_…) must NEVER go in any .env file:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
VITE_BAKONG_MERCHANT_ID=""

# OAuth 2.0 Providers (Google / Telegram / Apple) — public client IDs only.
# ⚠ NEVER put an OAuth client secret here with a VITE_ prefix: every VITE_ variable is bundled
#   into the public JavaScript. A browser app using Firebase Auth doesn't need the secret; keep it
#   only in a server environment (e.g. Cloud Functions / Secret Manager) if you ever need one.
VITE_OAUTH_CLIENT_ID=""
